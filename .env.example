# ==========================================
# SafeNet AI - Environment Configuration
# ==========================================

# Application Environment (development | production)
ENV=development
ENVIRONMENT=development
PORT=5000

# Security & API Authentication
# Predefined test keys: "safenet_admin_2026", "safenet_guard_2026"
API_KEY=safenet_admin_2026

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Secondary Python AI Server URL
AI_BACKEND_URL=http://localhost:8000

# Database (PostgreSQL - Optional for persistent storage; defaults to MemStorage)
# DATABASE_URL=postgresql://user:password@localhost:5432/safenet

# Google Cloud Platform (Optional - Mocked by default)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
# VERTEX_AI_LOCATION=us-central1
